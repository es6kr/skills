#!/usr/bin/env sh

# Pre-push gate — mirrors the CI "Test" workflow (.github/workflows/test.yml)
# so failures are caught locally instead of only after push. The three checks
# below are 1:1 with the heavier CI jobs: frontmatter-lint, bats, pytest.
# The hangul-check CI job runs in pre-commit instead (see .githooks/pre-commit)
# so Korean text is rejected at commit time before the push attempt.
# Keep this in sync whenever a CI job is added/changed.

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# 'local' branch push guard — HARD STOP (double-defense with workspace rule
# 'agents-local-branch-nopush.md'). The 'local' branch is a user-private
# stage / working branch; pushing it to origin pollutes other environments
# and it is not a valid PR head (see git.md "PR head branch name convention").
# stdin is the pre-push protocol: `<local_ref> <local_sha> <remote_ref> <remote_sha>` lines.
LOCAL_PUSH_ATTEMPTED=0
HAS_REAL_PUSH=0
LOCAL_STDIN=""
while IFS= read -r line; do
  LOCAL_STDIN="${LOCAL_STDIN}${line}
"
  # shellcheck disable=SC2086
  set -- $line
  local_ref="${1:-}"
  local_sha="${2:-}"
  remote_ref="${3:-}"
  remote_sha="${4:-}"

  # Skip branch deletions with `continue` (skip THIS ref only). `exit 0` here would
  # abort the whole hook on the first delete ref, bypassing the 'local'-guard for any
  # non-delete ref in the same push (a mixed delete + 'local' update). Heavy CI is still
  # skipped for a delete-only push via the HAS_REAL_PUSH check after the loop.
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ] || [ "$local_sha" = "(delete)" ]; then
    continue
  fi
  HAS_REAL_PUSH=1

  if [ "$local_ref" = "refs/heads/local" ] || [ "$remote_ref" = "refs/heads/local" ]; then
    LOCAL_PUSH_ATTEMPTED=1
  fi

  # Commit count limit guard — prevent pushing massive commits from wrong base branch
  # Exclude commits that already exist on remote tracking branches (--remotes=origin)
  # so that merged upstream/remote branches (e.g. origin/main, origin/next-fix) do not
  # inflate the count of genuinely new outgoing commits.
  if [ "$remote_sha" != "0000000000000000000000000000000000000000" ] && [ -n "$remote_sha" ]; then
    COMMIT_COUNT=$(git rev-list --count "$local_sha" --not "$remote_sha" --remotes=origin 2>/dev/null || echo 0)
  else
    DEFAULT_BASE="origin/main"
    case "$local_ref" in
      refs/heads/feat/*|feat/*)
        if git rev-parse --verify origin/next-feat >/dev/null 2>&1; then
          DEFAULT_BASE="origin/next-feat"
        fi
        ;;
      refs/heads/fix/*|fix/*)
        if git rev-parse --verify origin/next-fix >/dev/null 2>&1; then
          DEFAULT_BASE="origin/next-fix"
        fi
        ;;
    esac

    if [ "$DEFAULT_BASE" = "origin/main" ]; then
      MIN_COUNT=999999
      for cand in origin/next-feat origin/next-fix origin/main origin/master; do
        if git rev-parse --verify "$cand" >/dev/null 2>&1; then
          cnt=$(git rev-list --count "$local_sha" --not "$cand" --remotes=origin 2>/dev/null || echo 999999)
          if [ "$cnt" -lt "$MIN_COUNT" ]; then
            MIN_COUNT="$cnt"
            DEFAULT_BASE="$cand"
          fi
        fi
      done
    fi
    COMMIT_COUNT=$(git rev-list --count "$local_sha" --not "$DEFAULT_BASE" --remotes=origin 2>/dev/null || echo 0)
  fi

  # $remote_ref is the ref name on the REMOTE (e.g. refs/heads/next-fix). On a
  # same-name push it also resolves LOCALLY -- to the very branch being pushed --
  # so "$remote_ref..$local_sha" collapses to an empty range and every outgoing
  # commit scan below silently inspects nothing. The remote SHA is the true fork
  # point for an existing remote branch, so scan ranges use that instead.
  BASE_REF="${DEFAULT_BASE:-origin/main}"
  if [ "$remote_sha" != "0000000000000000000000000000000000000000" ] && [ -n "$remote_sha" ]; then
    SCAN_RANGE="$remote_sha..$local_sha"
  else
    SCAN_RANGE="$BASE_REF..$local_sha"
  fi

  MAX_COMMITS="${PUSH_MAX_COMMITS:-5}"
  if [ "$COMMIT_COUNT" -gt "$MAX_COMMITS" ] && [ "${PUSH_COMMIT_LIMIT_OVERRIDE:-0}" != "1" ]; then
    cat >&2 <<EOF
ERROR: Pushing $COMMIT_COUNT commits on '$local_ref' exceeds the limit ($MAX_COMMITS).
This usually happens when branching off the wrong base branch or accumulating diverged history.
Inspect commits with: git log --oneline $SCAN_RANGE
If this large batch push is intended, override with: PUSH_COMMIT_LIMIT_OVERRIDE=1 git push ...
EOF
    exit 1
  fi

  # Conflict marker guard — block push of a commit whose message still carries
  # the auto-generated "Conflicts:" residue (unresolved non-interactive merge commit)
  CONFLICT_COMMITS=$(git rev-list "$SCAN_RANGE" 2>/dev/null | while read -r sha; do
    if git log -1 --format='%B' "$sha" | grep -qE '^#?[[:space:]]*Conflicts:'; then
      echo "$sha"
    fi
  done || true)
  if [ -n "$CONFLICT_COMMITS" ] && [ "${PUSH_CONFLICT_MSG_OVERRIDE:-0}" != "1" ]; then
    cat >&2 <<EOF
ERROR: The following commit(s) still contain a leftover '# Conflicts:' section:
$(echo "$CONFLICT_COMMITS" | sed 's/^/   /')
This happens when a merge is committed non-interactively (--no-edit) after resolving conflicts.
Clean the message before pushing:
  - Tip commit:      git commit --amend  (drop the '# Conflicts:' lines, then save)
  - Older commit:    git rebase -i <parent-sha>  -> mark it 'reword', drop the lines
To override: PUSH_CONFLICT_MSG_OVERRIDE=1 git push ...
EOF
    exit 1
  fi

done
if [ "$LOCAL_PUSH_ATTEMPTED" = "1" ] && [ "${PUSH_LOCAL_OVERRIDE:-}" != "1" ]; then
  cat >&2 <<'GUARD_MSG'
ERROR: Pushing the 'local' branch to origin is blocked.

'local' is a user-private stage branch. Push a feature branch + PR instead:
    git switch -c <tag>/<scope>      # <tag>=docs|fix|feat, <scope>=short slug
    git cherry-pick <sha>...          # bring the commits you want to publish
    git push -u origin <tag>/<scope>
    gh pr create -R es6kr/skills --title '...' --body '...'

Rule: .claude/rules/agents-local-branch-nopush.md

If you truly intend to force-push 'local' (rare, requires explicit user consent):
    PUSH_LOCAL_OVERRIDE=1 git push origin local
GUARD_MSG
  exit 1
fi
# Re-emit the stdin we consumed so downstream logic (if any) sees the same lines.
# (Currently downstream CI checks below do not read stdin, but preserve the
# contract for future hook chaining.)
printf '%s' "$LOCAL_STDIN"

# Delete-only push (every ref was a deletion): nothing to test — skip heavy CI.
if [ "$HAS_REAL_PUSH" = "0" ]; then
  exit 0
fi

echo "Running pre-push checks (CI parity)..."

if ! command -v bats >/dev/null 2>&1; then
  echo "bats is required to run pre-push checks." >&2
  exit 1
fi

if ! command -v uvx >/dev/null 2>&1; then
  echo "uvx is required to run pre-push checks." >&2
  exit 1
fi

# Pick the first python that actually runs. A bare `command -v python3` is not
# enough on Windows, where `python3` resolves to a non-functional Microsoft
# Store App Execution Alias stub; probe each candidate so the broken stub is
# skipped in favour of a working `python`. CI (real python3) matches first.
PY=""
for cand in python3 python; do
  if command -v "$cand" >/dev/null 2>&1 && "$cand" -c "import sys" >/dev/null 2>&1; then
    PY="$cand"
    break
  fi
done
if [ -z "$PY" ]; then
  echo "no working python interpreter found on PATH" >&2
  exit 1
fi

# CI job: frontmatter-lint
echo "Checking SKILL.md frontmatter (scripts/lint-frontmatter.sh)..."
bash scripts/lint-frontmatter.sh

# CI job: hangul-check is enforced in .githooks/pre-commit (commit-time gate).

# CI job: bats (Structure Tests) — run the whole tests/ dir, not a single file.
echo "Running bats tests (tests/)..."
bats tests/

# CI job: pytest (Deploy Tests) — run the whole tests/ dir so test_check_hangul.py
# is exercised too, not just test_deploy.py.
echo "Running pytest (tests)..."
uvx --from pytest pytest tests -v
