#!/usr/bin/env bash
# .githooks/post-commit
# Automatically reflect local skill changes into Claude Code marketplace clone
# Enables instant 0-second testing in local agent sessions before PR/merge.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
DEV_REFLECT_SCRIPT="$REPO_ROOT/skills/cc-plugin/scripts/dev-reflect.sh"

if [ -f "$DEV_REFLECT_SCRIPT" ] && [ -d "$HOME/.claude/plugins/marketplaces/es6kr-skills" ]; then
  echo "[post-commit] Reflecting local changes to marketplace clone (es6kr-skills)..."
  if REFLECT_OUTPUT=$(bash "$DEV_REFLECT_SCRIPT" --source "$REPO_ROOT" --marketplace es6kr-skills 2>&1); then
    printf '%s\n' "$REFLECT_OUTPUT"
    case "$REFLECT_OUTPUT" in
      *"[dev-reflect] SKIP:"*) echo "[post-commit] Reflection skipped; destination preserved." ;;
      *) echo "[post-commit] dev-reflect completed." ;;
    esac
  else
    printf '[post-commit] WARNING: dev-reflect failed; no success claimed.\n%s\n' "$REFLECT_OUTPUT" >&2
  fi
fi

exit 0
